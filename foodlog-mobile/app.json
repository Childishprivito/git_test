{
  "expo": {
    "name": "FoodLog",
    "slug": "projectfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.childishprivito.foodlog",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.childishprivito.foodlog"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FoodLog uses the camera to scan barcodes and photograph food packages.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "FoodLog uses the camera to photograph food packages so AI can identify them.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FoodLog shows your activity, sleep, heart rate, weight and workouts on your profile and next to what you ate.",
          "NSHealthUpdateUsageDescription": "FoodLog saves the meals, workouts and weigh-ins you log to Apple Health.",
          "background": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "daunos-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aac44430-ef08-4e0e-baff-2f5a2affd45f",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "eas": {
        "projectId": "aac44430-ef08-4e0e-baff-2f5a2affd45f"
      }
    }
  }
}
